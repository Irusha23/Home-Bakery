# Copy this file to android/keystore.properties (gitignored) and fill in your private keystore details.
# IMPORTANT: Store the .jks file OUTSIDE the Git repository (e.g. C:/Users/<you>/.android-keystores/udenis-specials-release.jks)
# Use forward slashes (/) or escaped backslashes (\\) for Windows paths.
storeFile=C:/Users/YOUR_USERNAME/.android-keystores/udenis-specials-release.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=udenis-specials
keyPassword=YOUR_KEY_PASSWORD
